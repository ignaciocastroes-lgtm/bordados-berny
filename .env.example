# ============================================================
# Bordados Berny — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only — never expose to the browser (no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Mercado Pago (required for real payments) ─────────────────
# Get from: https://www.mercadopago.cl/developers/panel
# Server-only — used by app/api/payment/mp-preference and mp-webhook.
# Use the PRODUCTION access token (not the TEST one) to charge real cards.
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-...

# ── App URL (required — used for Mercado Pago's back_urls/notification_url) ──
NEXT_PUBLIC_APP_URL=https://bordados-berny.vercel.app

# ── Resend — email a Bernardita con fotos adjuntas en cada pedido nuevo ──────
# (Ronda 9 — opcional: si se omite, el pedido se crea igual y solo queda el
# aviso por WhatsApp sin adjuntos reales. Ver lib/email.ts.)
# 1. Crear cuenta en https://resend.com y verificar el dominio de envío.
# 2. Generar un API key en el dashboard de Resend.
RESEND_API_KEY=re_000000000000000000000000000
# Debe ser una dirección del dominio ya verificado en Resend.
EMAIL_FROM=pedidos@bordadosberny.cl
# El correo real de Bernardita — a donde llega el aviso con las fotos.
ADMIN_NOTIFICATION_EMAIL=bernardita@bordadosberny.cl
